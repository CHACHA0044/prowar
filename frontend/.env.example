# Frontend environment variables (Vercel Project → Settings → Environment Variables).
# Only NEXT_PUBLIC_* values are embedded in browser bundles.

# Render backend base URL (no trailing slash).
# Local development:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Production example:
# NEXT_PUBLIC_API_URL=https://sentinel-aml-api.onrender.com

# Supabase Auth is NOT enabled in Phase 2.5. The backend talks to Supabase
# PostgreSQL through SQLAlchemy only. These variables are reserved for a future
# authentication phase and must never contain a service-role key.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
