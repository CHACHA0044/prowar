# Sentinel.AML — consolidated environment template.
# Prefer backend/.env.example and frontend/.env.example for app-specific values.
# Never commit real credentials.

# Application Configuration
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="PromptWars AI Financial Fraud & AML Detection"

# Security & CORS (comma-separated exact origins; no wildcards in production)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ALLOW_LOCALHOST_ORIGINS=False
CORS_ORIGIN_REGEX=

# Database Configuration (SQLite local; Supabase PostgreSQL production)
DATABASE_URL=sqlite:///./financial_fraud_aml.db
# Supabase session pooler example (recommended for Render):
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_SSL_MODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_ECHO=False
AUTO_CREATE_SCHEMA=

# Optional simulator control token (X-Control-Token)
CONTROL_API_TOKEN=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Supabase Auth is not enabled in Phase 2.5.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
