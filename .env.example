# Application Configuration
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="PromptWars AI Financial Fraud & AML Detection"

# Security & CORS (comma-separated origins)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (SQLite default with clean PostgreSQL path)
DATABASE_URL=sqlite:///./financial_fraud_aml.db
# PostgreSQL alternative example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/promwar_db

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_ENV=development

