# Backend environment template (copy to backend/.env for local development).
# Never commit real credentials.

# Application
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
PROJECT_NAME="Financial Fraud Detection & AML Security Platform"
API_V1_STR=/api/v1

# Server binding (local only; Render injects PORT and binds to 0.0.0.0)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS — comma-separated exact origins. Wildcards are rejected in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional scoped regex for Vercel preview URLs, e.g.:
# CORS_ORIGIN_REGEX=^https://prowar-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=
ALLOW_LOCALHOST_ORIGINS=False

# Database — SQLite is for local development only.
DATABASE_URL=sqlite:///./financial_fraud_aml.db
# Supabase direct connection (IPv6-capable networks):
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Supabase session pooler (recommended for Render IPv4 compatibility):
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Supabase transaction pooler (port 6543) is not recommended for this long-lived API.

DB_SSL_MODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_ECHO=False

# Schema management. Leave empty to auto-create outside production.
# In production Render sets this to False and migrations are applied with Alembic.
AUTO_CREATE_SCHEMA=

# Optional shared token for simulator control mutations (X-Control-Token).
# When unset, simulator controls are public demo endpoints.
CONTROL_API_TOKEN=
