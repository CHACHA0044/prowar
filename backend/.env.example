# Sentinel.AML Backend Environment Configuration Example
# Static CSV Architecture — Zero Database Dependencies

# Environment mode: development | staging | production
ENVIRONMENT=production

# Debug flag (must be False in production)
DEBUG=False

# Application logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Server Binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins (comma-separated list of frontends)
# Set to your Vercel frontend URL in production
ALLOWED_ORIGINS=https://prowar-rho.vercel.app

# Optional: Path to transactions.csv (auto-discovered if unset)
# DATASET_PATH=../data/transactions.csv

# Optional: Set this to require X-Control-Token header on simulator control mutations
# CONTROL_API_TOKEN=your-render-control-secret
